# Pivot Pharmacy — server rules (Apache)
# Fixes audited systemic issues: no HTTPS enforcement, trailing-slash 404s, no caching/compression.

# ---------- Force HTTPS ----------
<IfModule mod_rewrite.c>
RewriteEngine On
# Redirect explicit .html requests to clean extensionless URL (301)
RewriteCond %{THE_REQUEST} \s/([^.]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [NC,L,R=301]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---------- Extensionless URLs ----------
# /about  -> serves /about.html  (nav uses .html internally; extensionless keeps working as canonical)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ---------- Custom 404 ----------
ErrorDocument 404 /404.html

# ---------- Compression ----------
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# ---------- Browser caching ----------
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType image/jpeg "access plus 3 months"
ExpiresByType image/png "access plus 3 months"
ExpiresByType image/webp "access plus 3 months"
</IfModule>
